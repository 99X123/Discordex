# Variáveis de ambiente do Discordex
# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase

# Supabase
# Encontre em: https://supabase.com → Seu Projeto → Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# WebRTC: o app busca STUN/TURN automaticamente na edge function
# `webrtc-ice-config` (veja supabase/functions/webrtc-ice-config/README.md).
# Configure o TURN gratuito da Cloudflare la e faça o deploy.
#
# Fallback opcional caso a edge function nao esteja publicada:
# VITE_TURN_URL=turn:seu-turn.example.com:3478
# VITE_TURN_USERNAME=usuario
# VITE_TURN_CREDENTIAL=senha