# Variáveis de ambiente do Discordex
# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase

# Supabase
# Encontre em: https://supabase.com → Seu Projeto → Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# WebRTC STUN/TURN (opcional para desenvolvimento local, necessário para produção)
# TURN server gratuito: https://www.metered.ca/tools/openrelay/
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject
